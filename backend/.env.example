# PartnerScout AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Options: openai, gemini, ollama
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini Configuration (alternative)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# Ollama Configuration (local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# =============================================================================
# Apify Configuration (Instagram Scraping)
# =============================================================================
APIFY_API_KEY=your-apify-api-key
APIFY_INSTAGRAM_SCRAPER_ID=apify/instagram-profile-scraper
APIFY_HASHTAG_SCRAPER_ID=apify/instagram-hashtag-scraper

# =============================================================================
# N8N Orchestration Configuration
# =============================================================================
N8N_SERVICE_KEY=your-n8n-service-key
N8N_WEBHOOK_URL=http://localhost:5678/webhook/partner-discovery

# =============================================================================
# Application Configuration
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
# Use API_PORT=8001 if port 8000 is in use (e.g. uvicorn app.main:app --port 8001)
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Rate Limits and Quotas
# =============================================================================
DAILY_JOB_LIMIT=10
MAX_PROFILES_PER_JOB=100
SCORING_BATCH_SIZE=5
REQUEST_TIMEOUT_SECONDS=30

# =============================================================================
# Scoring Configuration
# =============================================================================
MIN_SCORE_THRESHOLD=50
HIGH_SCORE_THRESHOLD=80
