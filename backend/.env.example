# .env.example - Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# CORE CONFIGURATION
# ===========================================
# Environment: development | staging | production
ENVIRONMENT=development
# Enable debug mode for verbose logging
DEBUG=true

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key (public)
SUPABASE_KEY=your-anon-key
# Supabase service role key (admin - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret for token verification
SUPABASE_JWT_SECRET=your-jwt-secret

# ===========================================
# DATABASE FALLBACK
# ===========================================
# Use local SQLite instead of Supabase (for development without Supabase)
USE_SQLITE_FALLBACK=false
# Path to SQLite database file
SQLITE_DATABASE_PATH=./data/partner_scout.db

# ===========================================
# API CONFIGURATION
# ===========================================
# Host to bind the API server
API_HOST=0.0.0.0
# Port for the API server
API_PORT=8000
# URL prefix for all API routes
API_PREFIX=/api
# Allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===========================================
# LLM CONFIGURATION
# ===========================================
# LLM provider to use: openai | gemini | ollama
LLM_PROVIDER=openai
# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
# Google/Gemini API key (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=AIza...
# Ollama base URL (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# APIFY CONFIGURATION
# ===========================================
# Apify API key for Instagram scraping
APIFY_API_KEY=apify_api_...
# Apify actor ID for Instagram scraper
APIFY_INSTAGRAM_SCRAPER_ID=apify/instagram-scraper

# ===========================================
# RATE LIMITING
# ===========================================
# Maximum requests per rate limit period
RATE_LIMIT_REQUESTS=100
# Rate limit time window in seconds
RATE_LIMIT_PERIOD=60
