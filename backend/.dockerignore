# =============================================================================
# Backend .dockerignore
# Excludes files that should NOT be copied into the Docker image
# This keeps the image small and avoids leaking secrets
# =============================================================================

# Virtual environment — deps are installed fresh via pip in the Dockerfile
venv/
.venv/
env/

# Python cache files — rebuilt at runtime
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment files — secrets must NOT be baked into the image
# (they're mounted at runtime via env_file in docker-compose.yml)
.env
.env.*

# Test files — not needed in production
tests/
pytest.ini
.pytest_cache/
htmlcov/
.coverage

# Development tools config
.mypy_cache/
.ruff_cache/

# IDE files
.vscode/
.idea/

# Git
.git/
.gitignore

# Docker files (prevent recursive copy)
Dockerfile
.dockerignore

# Documentation
*.md
docs/
