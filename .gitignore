# ============================================
# Partner-Scout .gitignore
# ============================================

# ============================================
# Environment & Secrets
# ============================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ============================================
# Python
# ============================================
# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/

# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
build/
dist/
*.egg
*.egg-info/
.eggs/
*.whl

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Linting
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/

# ============================================
# Node.js / Frontend
# ============================================
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/

# Build outputs
out/
build/

# ============================================
# IDE & Editors
# ============================================
# VSCode (keep settings but ignore local files)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*.sw?
*~

# Sublime Text
*.sublime-workspace
*.sublime-project

# ============================================
# OS Generated Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

# ============================================
# Supabase
# ============================================
.supabase/
supabase/.branches/
supabase/.temp/

# ============================================
# n8n
# ============================================
.n8n/

# ============================================
# Miscellaneous
# ============================================
# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Local development
*.local
local/

# Secrets and credentials
*.pem
*.key
*.crt
credentials.json
secrets.json
service-account*.json

# Database
*.db
*.sqlite
*.sqlite3

# Debug
debug/
*.debug
