# PartnerScout AI - N8N Environment Variables
# STORY-4.1.1: Copy this file to .env and configure for your environment
#
# Used by: docker compose -f docker-compose.n8n.yml

# =============================================================================
# Required: FastAPI Backend URL
# =============================================================================
# When N8N runs in Docker: use host.docker.internal to reach host machine
# When N8N runs via npm: use localhost
# Examples:
#   Docker (Windows/Mac): http://host.docker.internal:8000
#   Docker (Linux):       http://172.17.0.1:8000 or your host IP
#   npm (same machine):   http://localhost:8000
FASTAPI_BASE_URL=http://host.docker.internal:8000

# =============================================================================
# Required: Service Key for API Authentication
# =============================================================================
# MUST match N8N_SERVICE_KEY in backend/.env
# Used by N8N HTTP nodes when calling FastAPI status/agent endpoints
N8N_SERVICE_KEY=test-service-key-12345

# =============================================================================
# Optional: N8N Security (Production)
# =============================================================================
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=secure-password
